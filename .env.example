# ----------------------------------------------------------------------------
# Amazon IVS Real-time Studio — environment template.
# Copy to `.env` and fill in. NEVER commit real keys.
# ----------------------------------------------------------------------------

# AWS account / region. IVS Real-time (Stages) is GA in us-east-1, us-west-2,
# eu-west-1, ap-northeast-1. Pick one of those.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: separate IAM credentials just for IVS (legacy support).
AWS_ACCESS_KEY_ID_IVS=
AWS_SECRET_ACCESS_KEY_IVS=

# Where the Express backend listens.
SERVER_PORT=4000

# DynamoDB table names. Override per-env to share an account.
DDB_TABLE_BROADCASTS=IVSRT_Broadcasts
DDB_TABLE_VIEWERS=IVSRT_Viewers
DDB_TABLE_PRIVATE_ACCESS=IVSRT_PrivateAccess
DDB_TABLE_PARTICIPANTS=IVSRT_Participants

# Per-broadcast viewer cap (the broadcaster can override per session).
DEFAULT_MAX_VIEWERS=500

# Payment provider (leave empty to run in MOCK mode — confirm code is "PAY").
STRIPE_SECRET_KEY=
